# Gemini API Key (Get free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS Origins (comma-separated, add your Vercel URL when deploying)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# Port for local or server hosting
PORT=8000

# Optional Hugging Face Hub repository containing pre-trained .keras models
HF_REPO_ID=

# Optional direct URL where .keras models are hosted
MODEL_BASE_URL=
